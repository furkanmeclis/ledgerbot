# ledgerbot on Dokploy: paste into the compose service's Environment tab.
# Dokploy writes it to .env next to compose.yml; every LEDGERBOT_* value also
# reaches the api and worker containers (env_file).

# --- optional parts: any of demo, docs, observability, whatsapp (comma separated)
COMPOSE_PROFILES=demo,docs,observability,whatsapp

# --- domains (A records must point at the server before you add them in Dokploy)
API_DOMAIN=api.example.com
LEDGERBOT_PUBLIC_URL=https://api.example.com

# --- secrets: openssl rand -hex 32 for each
POSTGRES_PASSWORD=
LEDGERBOT_SECRET_KEY=
LEDGERBOT_ADMIN_TOKEN=

# --- mode. true enables /v1/dev/* and the simulator, which the demo console needs.
# The demo API keys are public (seed/companies), so a server with LEDGERBOT_DEV=true
# is a demo server: keep real company data off it.
LEDGERBOT_DEV=true
LEDGERBOT_LOG_LEVEL=info
LEDGERBOT_TENANT_SOURCE=file
LEDGERBOT_DATA_DRIVER=fake
LEDGERBOT_SIMULATE_EVERY=30s
LEDGERBOT_FX_SOURCE=tcmb

# --- AI providers. Empty = offline fake providers (no cost).
# Real providers: minified providers.json on ONE line in single quotes, plus the file path.
# LEDGERBOT_PROVIDERS_JSON='{"profiles":[...],"defaults":{...}}'
# LEDGERBOT_PROVIDERS_FILE=/app/config/providers.json
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- sizing: 4 GB server (Dokploy itself takes ~1 GB). See the guide for 8 GB.
API_REPLICAS=2
WORKER_REPLICAS=3
LEDGERBOT_DB_MAX_CONNS=10
LEDGERBOT_WORKER_CONCURRENCY=32
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_MEM_LIMIT=1g
API_MEM_LIMIT=384m
API_GOMEMLIMIT=320MiB
WORKER_MEM_LIMIT=384m
WORKER_GOMEMLIMIT=320MiB

# --- tracing (profile observability)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LEDGERBOT_TRACE_RATIO=0.2

# --- docs site (profile docs)
DOCS_PASSWORD=
DOCS_SESSION_SECRET=
DOCS_PROD_URL=https://api.example.com
DOCS_STAGE_URL=
DOCS_PROD_HOST_URL=
DOCS_STAGE_HOST_URL=

# --- Grafana (profile observability)
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://grafana.example.com

# --- WuzAPI (profile whatsapp): openssl rand -hex 16 / -hex 32
WUZAPI_ADMIN_TOKEN=
WUZAPI_GLOBAL_ENCRYPTION_KEY=
WUZAPI_GLOBAL_HMAC_KEY=

# --- Meta WhatsApp Cloud API app (only if you use WABA)
LEDGERBOT_META_APP_SECRET=
