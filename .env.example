# ledgerbot configuration. Copy to .env and adjust.

# --- core
LEDGERBOT_HTTP_ADDR=:8080
LEDGERBOT_PUBLIC_URL=http://localhost:8080
LEDGERBOT_LOG_LEVEL=info
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
LEDGERBOT_SECRET_KEY=
LEDGERBOT_ADMIN_TOKEN=change-me
# true enables /v1/dev/* and /v1/simulator/run, and allows an empty secret key.
LEDGERBOT_DEV=true

# --- database (compose overrides the URL)
LEDGERBOT_DATABASE_URL=postgres://ledgerbot:ledgerbot@localhost:5432/ledgerbot?sslmode=disable
LEDGERBOT_DB_MAX_CONNS=40

# --- tenant contracts: settings + permission matrix
# file: read seed/companies/*.json   http: GET {HOST_API_URL}/companies/{id}/settings|permissions
LEDGERBOT_TENANT_SOURCE=file
LEDGERBOT_SEED_DIR=seed/companies
LEDGERBOT_HOST_API_URL=
LEDGERBOT_HOST_API_TOKEN=
LEDGERBOT_TENANT_TTL=30s

# --- data provider: fake (seed + simulator) or api (host REST API)
LEDGERBOT_DATA_DRIVER=fake
# Run the event simulator every N (0 disables), e.g. 30s for demos.
LEDGERBOT_SIMULATE_EVERY=0

# --- AI providers: empty = offline fake providers. See providers.example.json.
LEDGERBOT_PROVIDERS_FILE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- FX: tcmb (Central Bank daily XML) or static (offline demo rates)
LEDGERBOT_FX_SOURCE=tcmb

# --- Meta data deletion callback (WhatsApp Cloud API apps)
LEDGERBOT_META_APP_SECRET=

# --- scaling
LEDGERBOT_WORKER_CONCURRENCY=64
LEDGERBOT_PER_COMPANY_INFLIGHT=4
LEDGERBOT_MAX_LISTENERS=1000
LEDGERBOT_RATE_RPS=20
LEDGERBOT_RATE_BURST=40
