# Ledgerbot documentation site. Copy to .env.

# Required: the shared sign-in password.
DOCS_PASSWORD=
# Optional: key for session cookies (default: derived from DOCS_PASSWORD). openssl rand -hex 32
DOCS_SESSION_SECRET=
DOCS_SESSION_TTL_HOURS=12
# true/false forces the cookie Secure flag; empty = follow HTTPS / X-Forwarded-Proto.
DOCS_COOKIE_SECURE=

# Base URLs shown in the docs (read at request time; restart to apply).
DOCS_PROD_URL=
DOCS_STAGE_URL=
DOCS_PROD_HOST_URL=
DOCS_STAGE_HOST_URL=
DOCS_PROD_LABEL=Production
DOCS_STAGE_LABEL=Staging

# Host port for compose.
DOCS_PORT=3001
