{
  "name": "ledgerbot-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Demo control dashboard for ledgerbot (fake data, simulated channels).",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.js",
    "typecheck": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.16.3",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@tailwindcss/vite": "4.1.13",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "9.2.1",
    "lucide-react": "0.544.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "socket.io-client": "4.8.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "7.1.6"
  }
}
